# ==============================================================================
# HƯỚNG DẪN: Copy file này thành `application-local.yaml` và điền mật khẩu Supabase của nhóm.
# File `application-local.yaml` đã được thêm vào `.gitignore` để không bị lộ credentials.
# ==============================================================================

spring:
  config:
    activate:
      on-profile: local

  datasource:
    # URL kết nối Supabase Pooler (Region ap-northeast-2 Seoul)
    url: jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require&tcpKeepAlive=true&connectTimeout=30&socketTimeout=60
    username: postgres.uuqydetbopbuvutpxhbh
    # Điền mật khẩu database Supabase:
    password: [YOUR-PASSWORD]
    driver-class-name: org.postgresql.Driver
    hikari:
      maximum-pool-size: 10
      minimum-idle: 2
      idle-timeout: 300000
      max-lifetime: 600000
      keepalive-time: 30000
      connection-timeout: 30000
      pool-name: SupabaseHikariCP

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        format_sql: true
        jdbc:
          lob:
            non_contextual_creation: true

app:
  cors:
    allowed-origins: "http://localhost:5173,http://127.0.0.1:5173"
